generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// Users & Identities
// ------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String?  @unique
  phone        String?  @unique
  password     String?
  role         String   @default("USER") // USER, ADMIN, MERCHANT
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED
  referralCode String?  @unique
  referredById String?  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  identities        UserIdentity[]
  entries           Entry[]
  payments          Payment[]
  merchantCampaigns Campaign[]     @relation("MerchantCampaigns")
  ledgerAccount     LedgerAccount?
}

model UserIdentity {
  id         String   @id @default(uuid())
  userId     String   
  provider   String   // 'telegram', 'email', 'google'
  providerId String   // Telegram User ID or external ID
  linkedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

// ------------------------------------------------------
// Campaigns & Prizes
// ------------------------------------------------------

model Campaign {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  description  String
  entryPrice   Int      // Stored in minor units (e.g. cents)
  currency     String   @default("ETB")
  maxEntries   Int
  startsAt     DateTime
  endsAt       DateTime
  status       String   @default("DRAFT") // DRAFT, ACTIVE, CLOSED, DRAWING, COMPLETED, CANCELLED
  imageUrl     String?  // Main campaign image/thumbnail
  merchantId   String?  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant     User?    @relation("MerchantCampaigns", fields: [merchantId], references: [id], onDelete: SetNull)
  prizes       Prize[]
  entries      Entry[]
  draw         Draw?
}

model Prize {
  id          String   @id @default(uuid())
  campaignId  String   
  title       String
  value       Int      // Minor units
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// Entries & Draws
// ------------------------------------------------------

model Entry {
  id           String   @id @default(uuid())
  campaignId   String   
  userId       String   
  paymentId    String?  
  entryNumber  Int
  status       String   @default("VALID") // VALID, REFUNDED, VOID
  createdAt    DateTime @default(now())

  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment      Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([campaignId, entryNumber])
}

model Draw {
  id              String   @id @default(uuid())
  campaignId      String   @unique 
  snapshotHash    String?
  randomSeed      String?
  winningEntryId  String?  @unique 
  status          String   @default("PENDING") // PENDING, COMPLETED
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
}

// ------------------------------------------------------
// Payments (Offline MVP)
// ------------------------------------------------------

model Payment {
  id             String   @id @default(uuid())
  userId         String   
  amount         Int      // Minor units
  currency       String   @default("ETB")
  provider       String   // 'MANUAL_TELEBIRR', 'MANUAL_CBE'
  transactionId  String?
  screenshotUrl  String?
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries        Entry[]
  
  @@unique([provider, transactionId])
}

// ------------------------------------------------------
// Ledger (Financial Source of Truth)
// ------------------------------------------------------

model LedgerAccount {
  id        String   @id @default(uuid())
  userId    String   @unique 
  balance   Int      @default(0) // Cache of transactions sum (minor units)
  currency  String   @default("ETB")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions LedgerTransaction[]
}

model LedgerTransaction {
  id            String   @id @default(uuid())
  accountId     String   
  amount        Int      // Positive (Credit) or Negative (Debit)
  referenceType String   // 'PAYMENT_DEPOSIT', 'ENTRY_PURCHASE', 'REFUND'
  referenceId   String   
  description   String?
  createdAt     DateTime @default(now())

  account       LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
